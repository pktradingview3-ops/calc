<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the security-test manifest. The CAMERA permission and the test
     activity are merged into debug APKs only; release APKs contain neither. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Requested at runtime, with a clear on-screen rationale, and only from the
         visible Security Test Mode screen. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application>
        <activity
            android:name=".security.SecurityTestActivity"
            android:exported="false"
            android:theme="@style/Theme.Calc"
            android:label="Calc · Security Test Mode"
            android:screenOrientation="portrait" />
    </application>
</manifest>
